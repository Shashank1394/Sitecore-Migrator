# ============================================================
# SitecoreAI — Authoring & Management API (Agent API)
# ============================================================

# Your SitecoreAI CM instance host
SITECORE_AI_CM_HOST=https://your-instance.sitecorecloud.io

# OAuth client credentials (Environment automation client)
# Create at: SitecoreAI Portal → Organization → API keys → Automation clients
SITECORE_AI_CLIENT_ID=your-client-id
SITECORE_AI_CLIENT_SECRET=your-client-secret

# Optional: override the OAuth audience (default: https://api.sitecorecloud.io)
# SITECORE_AI_AUDIENCE=https://api.sitecorecloud.io
