# ============================================================
# Sitecore XP
# ============================================================

SITECORE_XP_GRAPHQL_ENDPOINT=https://your-sitecore-xp-host/sitecore/api/edge/graphql
SITECORE_XP_GRAPHQL_API_KEY={YOUR-XP-GRAPHQL-API-KEY}

SITECORE_XP_SERVER_URL=https://your-sitecore-xp-host
SITECORE_XP_USERNAME=admin
SITECORE_XP_PASSWORD=your-password


# ============================================================
# SitecoreAI
# ============================================================

# Add the SitecoreAI MCP connection values here once the
# SitecoreAI MCP server configuration is finalized.

SITECORE_AI_ENDPOINT=https://your-sitecore-ai-host
SITECORE_AI_API_KEY=your-sitecore-ai-api-key


# ============================================================
# Migration
# ============================================================

SITECORE_MIGRATION_LANGUAGE=en

SITECORE_SOURCE_DATABASE=master
SITECORE_TARGET_DATABASE=master