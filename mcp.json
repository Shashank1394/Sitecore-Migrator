{
  "servers": {
    "Sitecore XP": {
      "type": "stdio",
      "command": "npx",
      "args": ["@antonytm/mcp-sitecore-server@latest"],
      "env": {
        "TRANSPORT": "stdio",
        "GRAPHQL_ENDPOINT": "${SITECORE_XP_GRAPHQL_ENDPOINT}",
        "GRAPHQL_SCHEMAS": "edge,master,core",
        "GRAPHQL_API_KEY": "${SITECORE_XP_GRAPHQL_API_KEY}",
        "ITEM_SERVICE_SERVER_URL": "${SITECORE_XP_SERVER_URL}",
        "ITEM_SERVICE_DOMAIN": "sitecore",
        "ITEM_SERVICE_USERNAME": "${SITECORE_XP_USERNAME}",
        "ITEM_SERVICE_PASSWORD": "${SITECORE_XP_PASSWORD}"
      }
    },
    "SitecoreAI Marketer": {
      "url": "https://marketer.sitecorecloud.io/mcp/marketer-mcp-prod",
      "auth": {
        "type": "external"
      }
    }
  }
}
